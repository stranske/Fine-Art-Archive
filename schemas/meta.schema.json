{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stranske.io/fine-art-archive/meta.schema.json",
  "title": "Fine Art Archive Sidecar (meta.json)",
  "description": "Per-work sidecar for the canonical archive. One file per work_id directory.",
  "type": "object",
  "required": [
    "work_id",
    "schema_version",
    "artist",
    "title",
    "files",
    "history"
  ],
  "additionalProperties": false,
  "properties": {
    "work_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{7}-[a-z0-9-]+$",
      "description": "Stable identifier: 7-char SHA-256 prefix of the master plus a Title-cased slug."
    },
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "category": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "painting",
        "drawing",
        "print",
        "sculpture",
        "photograph",
        "illuminated_manuscript",
        "fresco",
        "mural",
        "tapestry",
        "altarpiece",
        "icon",
        "architecture",
        "stained_glass",
        "mosaic",
        "monument",
        "architectural_sculpture",
        "other",
        null
      ],
      "default": null,
      "description": "Top-level work category written by the acquisition pipeline. The SITE-ANCHORED class is a DERIVED predicate (not stored): category in {architecture, stained_glass, mosaic, monument, architectural_sculpture} marks an in-situ, place-bound object whose identity anchors on the `site` block rather than `artist`. See site_anchored_category_design.md."
    },
    "subject": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "description": "CLIP subject-reviewer output (Companion App): genre, genre_confidence/source/evidence, and content_tags[]. Shape kept open while the tagger evolves."
    },
    "artist": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ],
          "description": "Display string as it appears in the source (e.g., 'Workshop of Rembrandt', 'After Caravaggio', 'Unknown artist'). MAY be null when a debris-repair pass has stripped an unusable junk name and no attribution is yet known -- a TRANSIENT state, not a final verdict: such works must go through image search (which recovers many) before null is accepted as correct. The structured attribution fields below carry the resolved relationship."
        },
        "given": {
          "type": [
            "string",
            "null"
          ]
        },
        "family": {
          "type": [
            "string",
            "null"
          ]
        },
        "lifespan": {
          "type": [
            "string",
            "null"
          ],
          "description": "e.g. '1844-1926'"
        },
        "nationality": {
          "type": [
            "string",
            "null"
          ]
        },
        "wikidata_q": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^Q[0-9]+$",
          "description": "When relation='self' or omitted: the personal Q-ID of the artist. When relation is 'workshop'/'circle'/'after'/'follower'/'attributed': the Q-ID of the REFERENCE artist (e.g., Q5598 for 'Workshop of Rembrandt'). When relation='anonymous': null (and 'attribution_anchor' carries Q4233718)."
        },
        "ulan": {
          "type": [
            "string",
            "null"
          ]
        },
        "relation": {
          "description": "Art-historical attribution relation. Defaults to 'self' (the named artist created the work). Other values follow museum-cataloging conventions and Wikidata's P1773 (object has role) statement qualifiers. 'unknown' is for when the source filename doesn't carry enough information to decide; web-search recovery may upgrade it later.",
          "enum": [
            "self",
            "workshop",
            "circle",
            "after",
            "follower",
            "attributed",
            "school",
            "anonymous",
            "unknown"
          ],
          "default": "self"
        },
        "attribution_confidence": {
          "description": "How firm the relation is. 'scholarly_consensus' = a museum or catalogue raisonné says so; 'attributed' = current attribution but not unanimous; 'inferred' = derived from filename or weak source signal; 'uncertain' = best guess.",
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "scholarly_consensus",
            "attributed",
            "inferred",
            "uncertain",
            null
          ]
        },
        "attribution_anchor": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^Q[0-9]+$",
          "description": "Wikidata Q-ID classifying the attribution kind, used chiefly for the anonymous case: Q4233718 (anonymous). For the person relations (workshop/circle/after/follower/attributed) the 'relation' enum plus the reference-artist 'wikidata_q' already carry the kind, so this is usually null there. No stable Q-ID cleanly denotes 'workshop' or 'school of art' -- do not guess one (the earlier examples Q23807/Q3343150 were wrong: Q23807 is now 'Bank of China Building')."
        },
        "canonical": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true,
          "description": "Resolver output: canonical identity for the raw artist.name string. Lets the UI group spelling variants ('Brueghel' ↔ 'Bruegel'). artist.name stays as the raw source attribution for provenance.",
          "properties": {
            "wikidata_q": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^Q[0-9]+$"
            },
            "display_name": {
              "type": [
                "string",
                "null"
              ]
            },
            "lifespan": {
              "type": [
                "string",
                "null"
              ]
            },
            "family_key": {
              "type": [
                "string",
                "null"
              ]
            },
            "method": {
              "type": [
                "string",
                "null"
              ]
            },
            "confidence": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            },
            "resolved_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "notes": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "title_alternate": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "year": {
      "type": [
        "string",
        "null"
      ],
      "description": "Year as it appears in the source"
    },
    "year_min": {
      "type": [
        "integer",
        "null"
      ]
    },
    "year_max": {
      "type": [
        "integer",
        "null"
      ]
    },
    "medium": {
      "type": [
        "string",
        "null"
      ]
    },
    "dimensions_original": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "h_cm": {
          "type": [
            "number",
            "null"
          ]
        },
        "w_cm": {
          "type": [
            "number",
            "null"
          ]
        },
        "raw": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "holder": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "wikidata_q": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^Q[0-9]+$"
        },
        "ror": {
          "type": [
            "string",
            "null"
          ]
        },
        "accession": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        }
      }
    },
    "site": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "description": "Place anchor for site-anchored / in-situ works (architecture, stained glass, mosaics, monuments) whose identity is the PLACE + element, not a creator. For these, `artist.relation` is typically 'anonymous' and verification gates on the Commons reference SET in `commons_category` (DINOv2 cosine), not a single P18 pHash. See site_anchored_category_design.md.",
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ],
          "description": "Human-readable site name, e.g. 'Chartres Cathedral'."
        },
        "wikidata_q": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^Q[0-9]+$",
          "description": "Wikidata Q-ID of the site/building (e.g. Q188527 for Chartres Cathedral)."
        },
        "element": {
          "type": [
            "string",
            "null"
          ],
          "description": "The specific element within the site, e.g. 'South rose window'. The work_id is keyed on (site, element) so multiple captures collapse into one work."
        },
        "element_q": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^Q[0-9]+$",
          "description": "Wikidata Q-ID of the element, when separately catalogued."
        },
        "commons_category": {
          "type": [
            "string",
            "null"
          ],
          "description": "Wikimedia Commons category used as the verify reference SET, e.g. 'Category:Rose windows of Chartres Cathedral'."
        },
        "coordinates": {
          "type": [
            "string",
            "null"
          ],
          "description": "P625 coordinates as 'lat,lon'."
        },
        "depicts_q": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "pattern": "^Q[0-9]+$"
          },
          "description": "Wikidata 'depicts' (P180) Q-IDs."
        }
      }
    },
    "depicts": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "description": "Structured depicted subject identity, separate from the capture/site anchor. Use for place-bound works where the capture is an alternate view of the same place object.",
      "properties": {
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "wikidata_q": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^Q[0-9]+$"
        },
        "hierarchy": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "wikidata_q": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^Q[0-9]+$"
              }
            }
          }
        }
      }
    },
    "rights": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "public-domain",
            "rights-reserved",
            "unclear",
            "fair-use"
          ]
        },
        "evidence_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "evidence_wacz": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "description": "Evidence supporting the rights determination (string or structured)."
        }
      }
    },
    "description_short": {
      "type": "string",
      "default": "",
      "description": "Short form; lossless reproduction of the original Meural-style filename string."
    },
    "description_long": {
      "type": "string",
      "default": ""
    },
    "stable_identifiers": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "wikidata_q": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^Q[0-9]+$"
        },
        "part_of_q": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^Q[0-9]+$",
          "description": "Wikidata Q-ID of the larger work this item COMPOSES — a fresco cycle, polyptych, altarpiece, or numbered series. Mirrors Wikidata P361 (part of). Unlike `wikidata_q`, this value is SHARED across members by design and sharing it is not a defect: the 22 Giotto scenes of the Scrovegni Christ cycle all carry part_of_q=Q29353420 while each holds its own wikidata_q. Distinct from `site.wikidata_q`, which records where the item physically IS rather than what it composes; an in-situ panel legitimately has both."
        },
        "ulan_for_artist": {
          "type": [
            "string",
            "null"
          ]
        },
        "ulan": {
          "type": [
            "string",
            "null"
          ]
        },
        "aat": {
          "type": [
            "string",
            "null"
          ]
        },
        "tgn": {
          "type": [
            "string",
            "null"
          ]
        },
        "museum_accession": {
          "type": [
            "string",
            "null"
          ]
        },
        "museum_institution_ror": {
          "type": [
            "string",
            "null"
          ]
        },
        "iiif_manifest_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "doi": {
          "type": [
            "string",
            "null"
          ]
        },
        "ark": {
          "type": [
            "string",
            "null"
          ]
        },
        "commons_file": {
          "type": [
            "string",
            "null"
          ],
          "description": "Wikimedia Commons File: name for the work image."
        }
      }
    },
    "field_provenance": {
      "type": "object",
      "description": "Per-field research ledger. Values remain in their existing fields; this records whether and how each field was checked.",
      "additionalProperties": {
        "type": "object",
        "required": [
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "not_researched",
              "available",
              "not_available",
              "unverified",
              "conflicting"
            ]
          },
          "source": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "checked_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          },
          "prior_value": {
            "type": [
              "string",
              "null"
            ],
            "description": "The value this field held before the pass that wrote this provenance record. Set by passes that overwrite an existing value (e.g. the artist-QID triage pass records the superseded QID here) so a correction is reversible."
          },
          "prior_name": {
            "type": [
              "string",
              "null"
            ],
            "description": "The prior artist.name a repair pass superseded. Analogous to prior_value but specific to the artist-field debris-repair pass, which records the discarded name string here so the correction is reversible."
          }
        }
      }
    },
    "dossier": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "description": "Viewer-facing enriched context: a plain-language summary, attributed key facts, and ranked durable source references (link + Wayback + local snapshot).",
      "properties": {
        "viewer_summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "key_facts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "string"
              },
              "source_id": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "title": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "publisher": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "license": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "redistributable": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "live_url": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uri"
              },
              "wayback_url": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uri"
              },
              "retrieved_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "content_hash": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "authority_score": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "commerce_flag": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "excerpt": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "local_snapshot_path": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "status": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "generated_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "reading": {
          "type": "array",
          "description": "PRIMARY. Close-looking: what is happening in the picture, where the eye enters and is led, which details reward a second look. Written for someone standing in front of the work.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "text": {
                "type": "string"
              },
              "source_id": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "stories": {
          "type": "array",
          "description": "PRIMARY. What enthusiasts actually discuss: odd or hidden details, running debates, surprising facts, and the work's cultural afterlife (poems, films, borrowings). Each carries a title.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "text": {
                "type": "string"
              },
              "source_id": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "composition": {
          "type": "array",
          "description": "PRIMARY. How the picture is built — lines, viewpoint, colour structure, spatial devices — and what technical imaging revealed about DESIGN decisions (figures added late, changes of mind). The imaging process itself belongs in technical_note, not here.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "text": {
                "type": "string"
              },
              "source_id": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "context": {
          "type": "array",
          "description": "SECONDARY. Placement in the artist's oeuvre and among other treatments of the theme.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "text": {
                "type": "string"
              },
              "source_id": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "provenance": {
          "type": "array",
          "description": "SECONDARY. Ownership chain, favouring episodes that carry a story over dry transfer records.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "text": {
                "type": "string"
              },
              "source_id": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "technical_note": {
          "type": [
            "string",
            "null"
          ],
          "description": "One short sentence on the technical examination and what it revealed, with process detail (equipment, resolutions) deliberately excluded — link out instead."
        },
        "research": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "description": "Background research state. `source_pool` is deliberately NOT displayed: it is the seed for a deeper research pass, including leads that were seen but not exploited. The API computes reader-facing research depth from this current dossier state.",
          "properties": {
            "source_pool": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "url": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "title": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "kind": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "status": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "used | promising | thin | paywalled | unread"
                  },
                  "note": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            },
            "design_version": {
              "type": [
                "string",
                "null"
              ],
              "description": "Which research design produced this, so designs can be honed over time."
            },
            "last_developed_at": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "modalities": {
      "type": [
        "array",
        "null"
      ],
      "description": "Alternative imaging modalities of the work (visible, infrared reflectography/underdrawing, X-ray, raking light, UV) presented as switchable layers in the viewer. Files live alongside the master in the work directory.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "modality": {
            "type": "string"
          },
          "label": {
            "type": [
              "string",
              "null"
            ]
          },
          "filename": {
            "type": [
              "string",
              "null"
            ]
          },
          "dimensions_px": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "integer"
            }
          },
          "source": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "license": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "deepzoom": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "description": "Gigapixel DeepZoom tile pyramids for pan/zoom in the viewer (OpenSeadragon). Tiles are served through the app, cached from the source pyramid on first view. Each layer maps to a source tile-id (fid) and its full pixel size.",
      "properties": {
        "tile_base": {
          "type": [
            "string",
